modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --test scripts/src/bookatlas-port.test.mjs"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
BOOKATLAS_OWNER_EMAIL = "apehgongedwin@gmail.com"
BOOKATLAS_EMAIL_FROM = "getintouch@apps-pilot.nl"
BOOKATLAS_EMAIL_MODE = "test"
SUPABASE_URL = "https://nodzslouearhjsiwhvst.supabase.co"
BOOKATLAS_TEST_BUDGET_USD = "1.00"
