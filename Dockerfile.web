# Multi-stage Dockerfile for Bookatlas Web Frontend
FROM node:24-alpine AS builder

WORKDIR /app
RUN npm install -g pnpm@11.25.0

# Copy workspace configuration, the preinstall guard and every workspace manifest
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY scripts/package.json scripts/check-package-manager.mjs ./scripts/
COPY artifacts/api-server/package.json ./artifacts/api-server/
COPY artifacts/bookatlas/package.json ./artifacts/bookatlas/
COPY artifacts/mockup-sandbox/package.json ./artifacts/mockup-sandbox/
COPY lib/bookatlas-catalog/package.json ./lib/bookatlas-catalog/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/api-zod/package.json ./lib/api-zod/
COPY lib/api-spec/package.json ./lib/api-spec/
COPY lib/db/package.json ./lib/db/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source files
COPY tsconfig.base.json tsconfig.json ./
COPY lib/ ./lib/
COPY attached_assets/ ./attached_assets/
COPY artifacts/bookatlas/ ./artifacts/bookatlas/

# Public Clerk key is baked into the bundle at build time; never pass the secret key here.
ARG VITE_CLERK_PUBLISHABLE_KEY=""
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY
ENV NODE_ENV=production
ENV BASE_PATH=/

# Build web bundle
RUN pnpm --filter "@workspace/bookatlas" run build

# Stage 2: Production Nginx Server
FROM nginx:alpine AS runner

COPY --from=builder /app/artifacts/bookatlas/dist/public /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/security-headers.conf /etc/nginx/snippets/security-headers.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
