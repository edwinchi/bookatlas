{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev:local": "node --env-file-if-exists=.env.local scripts/dev-local.mjs",
    "test:catalog": "node --experimental-strip-types --test scripts/src/catalog-search.test.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:port": "node --import tsx --test scripts/src/bookatlas-port.test.mjs",
    "test:e2e": "node scripts/run-e2e-tests.mjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
