# Copy to .env.local. Use matching keys from a Clerk DEVELOPMENT instance.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional owner bootstrap; never expose this as a VITE_ variable.
BOOKATLAS_OWNER_EMAIL=
WEB_PORT=5173
API_PORT=3001
# Optional stable local signing secret; blank generates one per launcher run.
SESSION_SECRET=
APP_URL=http://localhost:5173
# Optional existing Supabase project; blank uses nonpersistent seed data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
# Optional EPUBCheck worker (TASK-0003): 32+ random characters shared by the API and the worker.
# Blank skips EPUBCheck; submissions go straight to admin review.
EBOOK_WORKER_TOKEN=
# Stripe Checkout (TASK-0004). Blank keeps the demo checkout. Use sk_test_ keys until go-live.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<your domain>/api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=
# "on" once the tax registrations (NL VAT, EU OSS) are added in Stripe Tax.
STRIPE_TAX=
