# OPENROUTER_API_KEY: Primary AI provider for all text/JSON generation features
# (matchmaker, chat companion, book summaries, campaign copy, etc.). Preferred
# over Gemini because it's cheap/free-tier by default — see OPENROUTER_MODEL.
# Leave as-is to run those features on graceful local-heuristic fallbacks.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: which OpenRouter model to use. Defaults to a free-tier
# model if unset. Free models on OpenRouter rotate over time — check
# https://openrouter.ai/models if this one gets retired.
OPENROUTER_MODEL="nvidia/nemotron-3.5-lightning:free"

# GEMINI_API_KEY: Secondary/fallback provider — only reached if OpenRouter is
# not configured. Also still used for Gemini-exclusive features (video
# generation, Google Search grounding, TTS, multimodal image analysis) since
# OpenRouter can't do those.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: Optional persistent database.
# Leave as-is to run fully in-memory (data resets on restart).
# Set both to a real Supabase project (run db/schema.sql there first) to
# persist books, subscribers, categories, users, and campaigns.
# Service role key is server-side only — never expose it to the client.
SUPABASE_URL="your_supabase_project_url_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# UNSUBSCRIBE_TOKEN_SECRET: HMAC key used to sign 1-click unsubscribe tokens.
# Leave as-is for local dev. Set your own random value in production — the
# fallback below is public (it ships in this source file).
UNSUBSCRIBE_TOKEN_SECRET="bookatlas_unsub_hmac_default_secret_2026"
